+// Distributed TP currently has one physical GPU per process/rank.  The original
+// draft divided tensors equally between ranks, ignoring
+// LLAMA_DIST_TP_MODEL_TENSOR_SPLIT.  Treat that distributed setting as rank
+// weights when it contains one positive value per rank.  If it is absent or
+// invalid, retain the original equal split behaviour.
+static void llama_dist_tp_split_bounds(
+        int64_t n, int64_t granularity, int rank, int world_size,
+        int64_t * low, int64_t * high) {
+    GGML_ASSERT(world_size >= 1);
+    GGML_ASSERT(rank >= 0 && rank < world_size);
+    GGML_ASSERT(low != nullptr && high != nullptr);
+
+    if (world_size == 1 || n <= 0) {
+        *low = 0;
+        *high = n;
+        return;
+    }
+
+    double weight_before = 0.0;
+    double weight_through = 0.0;
+    double weight_total = 0.0;
+    bool weighted = false;
+
+    const char * split = std::getenv("LLAMA_DIST_TP_MODEL_TENSOR_SPLIT");
+    if (split != nullptr && split[0] != '\0') {
+        weighted = true;
+        const char * p = split;
+        for (int i = 0; i < world_size; ++i) {
+            char * end = nullptr;
+            const double weight = std::strtod(p, &end);
+            if (end == p || !std::isfinite(weight) || weight <= 0.0) {
+                weighted = false;
+                break;
+            }
+
+            weight_total += weight;
+            if (i < rank) {
+                weight_before += weight;
+            }
+            if (i <= rank) {
+                weight_through += weight;
+            }
+
+            p = end;
+            while (*p == ' ' || *p == '\t') {
+                ++p;
+            }
+            if (i + 1 < world_size) {
+                if (*p != ',') {
+                    weighted = false;
+                    break;
+                }
+                ++p;
+            } else if (*p != '\0') {
+                weighted = false;
+            }
+        }
+    }
+
+    int64_t lo = weighted ? (int64_t) (n * weight_before / weight_total) : n * rank / world_size;
+    int64_t hi = weighted ? (rank == world_size - 1 ? n : (int64_t) (n * weight_through / weight_total))
+                          : n * (rank + 1) / world_size;
+
+    const int64_t g = std::max<int64_t>(1, granularity);
+    if (g > 1) {
+        lo -= lo % g;
+        if (rank == world_size - 1) {
+            hi = n;
+        } else {
+            hi -= hi % g;
+        }
+        if (hi < lo) {
+            hi = lo;
+        }
+    }
+
+    *low = lo;
+    *high = hi;
+}
